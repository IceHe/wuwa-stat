# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/wuthering_waves

# CORS配置
FRONTEND_URL=https://stat.icehe.life

# 鉴权服务配置
AUTH_SERVICE_URL=http://127.0.0.1:8080
AUTH_SERVICE_TIMEOUT_SECONDS=5

# 账号管理服务配置
ACCOUNT_SERVICE_URL=http://127.0.0.1:8765
ACCOUNT_SERVICE_TIMEOUT_SECONDS=5

# 体力总览刷新通知
# 当 ACCOUNT_SERVICE_URL 指向远程 mgt 服务时，用于调用 /api/internal/dashboard/energy-revision
DASHBOARD_ENERGY_NOTIFY_TOKEN=

# 服务端口
PORT=8000
